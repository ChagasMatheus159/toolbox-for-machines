# Toolbox Configuration
# Copy to .env and adjust values

# API
TOOLBOX_PORT=9600

# Backend URLs (internal Docker network — don't change unless custom setup)
SEARXNG_URL=http://searxng:8888
CAMOUFOX_URL=http://camoufox:8790
WHISPER_URL=http://whisper:8200

# LLM (remote GPU host)
LLM_URL=http://192.168.3.118:8080/v1
LLM_API_KEY=dontfuckup!
LLM_MODEL=qwen3-vl-8b
LLM_MAX_CONCURRENT=1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=512

# Fetch settings
FETCH_TIMEOUT_SECONDS=30

# Cache
CACHE_ENABLED=true
CACHE_DB_PATH=/data/cache.db
